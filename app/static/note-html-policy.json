{
  "version": 1,
  "allowed_tags": [
    "a",
    "b",
    "blockquote",
    "br",
    "cite",
    "code",
    "dd",
    "del",
    "details",
    "div",
    "dl",
    "dt",
    "em",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "hr",
    "i",
    "img",
    "li",
    "mark",
    "math",
    "menclose",
    "mfrac",
    "mi",
    "mn",
    "mo",
    "mover",
    "mpadded",
    "mphantom",
    "mroot",
    "mrow",
    "mspace",
    "msqrt",
    "mstyle",
    "msub",
    "msubsup",
    "msup",
    "mtable",
    "mtd",
    "mtext",
    "mtr",
    "munder",
    "munderover",
    "ol",
    "p",
    "pre",
    "q",
    "s",
    "section",
    "small",
    "span",
    "strike",
    "strong",
    "sub",
    "summary",
    "sup",
    "table",
    "tbody",
    "td",
    "tfoot",
    "th",
    "thead",
    "tr",
    "u",
    "ul"
  ],
  "clean_content_tags": [
    "applet",
    "base",
    "button",
    "embed",
    "form",
    "iframe",
    "input",
    "link",
    "meta",
    "noscript",
    "object",
    "option",
    "script",
    "select",
    "style",
    "svg",
    "template",
    "textarea"
  ],
  "allowed_attributes": {
    "*": ["style"],
    "a": ["class", "data-ref-note-id", "data-ref-query", "href", "title"],
    "blockquote": ["cite"],
    "code": ["class"],
    "details": ["class"],
    "div": ["class", "data-markdown-rendered"],
    "img": ["alt", "height", "src", "title", "width"],
    "li": ["data-ref-query", "value"],
    "math": ["display", "xmlns"],
    "menclose": ["notation"],
    "mfrac": ["linethickness"],
    "mi": ["mathvariant"],
    "mn": ["mathvariant"],
    "mo": ["accent", "fence", "form", "largeop", "lspace", "mathvariant", "maxsize", "minsize", "movablelimits", "rspace", "separator", "stretchy"],
    "mover": ["accent"],
    "mpadded": ["depth", "height", "lspace", "mathbackground", "voffset", "width"],
    "mspace": ["depth", "height", "linebreak", "mathbackground", "width"],
    "mstyle": ["displaystyle", "mathbackground", "mathcolor", "scriptlevel"],
    "mtable": ["columnlines", "columnspacing", "displaystyle", "rowlines", "rowspacing"],
    "mtd": ["columnalign"],
    "mtext": ["mathvariant"],
    "munder": ["accent"],
    "ol": ["reversed", "start", "type"],
    "pre": ["class"],
    "q": ["cite"],
    "section": ["aria-label", "class"],
    "span": ["aria-hidden", "class", "data-ref-note-id", "title"],
    "summary": ["class"],
    "sup": ["aria-label", "class"],
    "td": ["colspan", "rowspan"],
    "th": ["colspan", "rowspan", "scope"]
  },
  "allowed_class_names": [
    "ai-chat-citation-link",
    "ai-chat-citation-marker",
    "ai-chat-message-content",
    "ai-chat-note-mention",
    "ai-chat-note-reference",
    "ai-chat-open-all-references",
    "ai-chat-reference-number",
    "ai-chat-references",
    "ai-chat-references-disclosure",
    "ai-chat-references-heading",
    "meta-latex",
    "meta-latex-display",
    "meta-latex-error",
    "meta-latex-inline",
    "meta-markdown",
    "meta-mermaid-source",
    "note-reference-block",
    "note-reference-content",
    "note-reference-link",
    "note-reference-link-icon",
    "note-reference-link-mode",
    "note-reference-link-title",
    "note-reference-note"
  ],
  "allowed_class_prefixes": ["language-"],
  "allowed_url_schemes": ["data", "http", "https", "mailto", "tel"],
  "allowed_style_properties": [
    "font-style",
    "font-weight",
    "height",
    "margin-left",
    "max-height",
    "max-width",
    "padding-left",
    "text-decoration",
    "text-decoration-line",
    "text-indent",
    "vertical-align",
    "white-space",
    "width"
  ],
  "block_style_properties": ["margin-left", "padding-left", "text-indent"],
  "image_style_properties": ["height", "max-height", "max-width", "width"],
  "max_data_image_bytes": 10485760
}
